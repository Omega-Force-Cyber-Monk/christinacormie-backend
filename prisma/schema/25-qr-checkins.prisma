enum QrStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum QrKitStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum CheckInStatus {
  PENDING
  VERIFIED
  REJECTED
  DUPLICATE
}

model TruckQrCode {
  id          String      @id @default(uuid()) @db.Uuid
  foodTruckId String      @map("food_truck_id") @db.Uuid
  code        String      @unique @db.VarChar(255)
  status      QrStatus    @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  foodTruck   FoodTruck   @relation(fields: [foodTruckId], references: [id])
  qrScans     QrScan[]

  @@map("truck_qr_codes")
}

model QrScan {
  id                 String                    @id @default(uuid()) @db.Uuid
  qrCodeId           String                    @map("qr_code_id") @db.Uuid
  foodTruckId        String                    @map("food_truck_id") @db.Uuid
  userId             String?                   @map("user_id") @db.Uuid
  anonymousSessionId String?                   @map("anonymous_session_id") @db.VarChar(255)
  scanLocation       Unsupported("geography")? @map("scan_location")
  openedProfile      Boolean                   @default(true) @map("opened_profile")
  completedCheckIn   Boolean                   @default(false) @map("completed_check_in")
  followedTruck      Boolean                   @default(false) @map("followed_truck")
  viewedDeal         Boolean                   @default(false) @map("viewed_deal")
  startedBooking     Boolean                   @default(false) @map("started_booking")
  scannedAt          DateTime                  @default(now()) @map("scanned_at") @db.Timestamptz(6)
  qrCode             TruckQrCode               @relation(fields: [qrCodeId], references: [id])
  foodTruck          FoodTruck                 @relation(fields: [foodTruckId], references: [id])
  user               User?                     @relation(fields: [userId], references: [id])
  checkIns           CheckIn[]

  @@map("qr_scans")
}

model CheckIn {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String                    @map("user_id") @db.Uuid
  foodTruckId            String                    @map("food_truck_id") @db.Uuid
  qrScanId               String?                   @map("qr_scan_id") @db.Uuid
  status                 CheckInStatus             @default(PENDING)
  verificationMethod     String                    @map("verification_method") @db.VarChar(30)
  userLocation           Unsupported("geography")? @map("user_location")
  distanceMeters         Decimal?                  @map("distance_meters") @db.Decimal(10, 2)
  locationAccuracyMeters Decimal?                  @map("location_accuracy_meters") @db.Decimal(10, 2)
  deviceId               String?                   @map("device_id") @db.VarChar(255)
  fraudScore             Decimal?                  @map("fraud_score") @db.Decimal(5, 2)
  locationVerified       Boolean                   @default(false) @map("location_verified")
  rejectionReason        String?                   @map("rejection_reason")
  verifiedAt             DateTime?                 @map("verified_at") @db.Timestamptz(6)
  checkedInAt            DateTime                  @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  user                   User                      @relation(fields: [userId], references: [id])
  foodTruck              FoodTruck                 @relation(fields: [foodTruckId], references: [id])
  qrScan                 QrScan?                   @relation(fields: [qrScanId], references: [id])
  promotionRedemptions   PromotionRedemption[]

  @@map("check_ins")
}

model QrKitShipment {
  id              String      @id @default(uuid()) @db.Uuid
  vendorId        String      @map("vendor_id") @db.Uuid
  foodTruckId     String      @map("food_truck_id") @db.Uuid
  status          QrKitStatus @default(PENDING)
  trackingNumber  String?     @map("tracking_number") @db.VarChar(255)
  shippingAddress String?     @map("shipping_address")
  shippedAt       DateTime?   @map("shipped_at") @db.Timestamptz(6)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  vendor          Vendor      @relation(fields: [vendorId], references: [id])
  foodTruck       FoodTruck   @relation(fields: [foodTruckId], references: [id])

  @@map("qr_kit_shipments")
}
