enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_ITEM
  CUSTOM
}

model Promotion {
  id              String                @id @default(uuid()) @db.Uuid
  foodTruckId     String                @map("food_truck_id") @db.Uuid
  title           String                @db.VarChar(255)
  description     String?
  type            PromotionType
  value           Decimal?              @db.Decimal(12, 2)
  couponCode      String?               @map("coupon_code") @db.VarChar(100)
  minimumSpend    Decimal?              @map("minimum_spend") @db.Decimal(12, 2)
  maximumDiscount Decimal?              @map("maximum_discount") @db.Decimal(12, 2)
  isFollowerOnly  Boolean               @default(false) @map("is_follower_only")
  usageLimit      Int?                  @map("usage_limit")
  startsAt        DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime              @map("ends_at") @db.Timestamptz(6)
  isActive        Boolean               @default(true) @map("is_active")
  foodTruck       FoodTruck             @relation(fields: [foodTruckId], references: [id])
  redemptions     PromotionRedemption[]

  @@map("promotions")
}

model PromotionRedemption {
  id             String    @id @default(uuid()) @db.Uuid
  promotionId    String    @map("promotion_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  bookingId      String?   @map("booking_id") @db.Uuid
  checkInId      String?   @map("check_in_id") @db.Uuid
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  redeemedAt     DateTime  @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  promotion      Promotion @relation(fields: [promotionId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
  booking        Booking?  @relation(fields: [bookingId], references: [id])
  checkIn        CheckIn?  @relation(fields: [checkInId], references: [id])

  @@map("promotion_redemptions")
}
