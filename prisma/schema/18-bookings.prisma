enum BookingType {
  QUICK_BOOKING
  EVENT
  CATERING
  PRIVATE_REQUEST
  COMMUNITY_REQUEST
}

enum BookingEventType {
  BIRTHDAY_PARTY
  CORPORATE_EVENT
  WEDDING
  WEDDING_RECEPTION
  GRADUATION_PARTY
  COMMUNITY_EVENT
  FUNDRAISER
  PRIVATE_PARTY
  OTHER
}

enum BookingPaymentPreference {
  DEPOSIT_ONLY
  PREPAID_IN_FULL
  NO_PREFERENCE
}

enum BookingStatus {
  PENDING
  QUOTED
  ACCEPTED
  PAYMENT_PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum BookingIssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum BookingIssueMessageSenderRole {
  CUSTOMER
  VENDOR
  ADMIN
}

model Booking {
  id                          String                @id @default(uuid()) @db.Uuid
  bookingNumber               String                @unique @map("booking_number") @db.VarChar(50)
  customerId                  String                @map("customer_id") @db.Uuid
  vendorId                    String                @map("vendor_id") @db.Uuid
  foodTruckId                 String                @map("food_truck_id") @db.Uuid
  communityRequestId          String?               @map("community_request_id") @db.Uuid
  vendorOfferId               String?               @map("vendor_offer_id") @db.Uuid
  bookingType                 BookingType           @map("booking_type")
  eventType                   BookingEventType?     @map("event_type")
  status                      BookingStatus         @default(PENDING)
  eventName                   String?               @map("event_name") @db.VarChar(255)
  eventDescription            String?               @map("event_description")
  startsAt                    DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt                      DateTime?             @map("ends_at") @db.Timestamptz(6)
  guestCount                  Int                   @map("guest_count")
  address                     String
  contactPhone                String?               @map("contact_phone") @db.VarChar(30)
  location                    Unsupported("geography")?
  distanceFromServiceCenterKm Decimal?              @map("distance_from_service_center_km") @db.Decimal(8, 2)
  outsideServiceRadius        Boolean               @default(false) @map("outside_service_radius")
  outsideRadiusFee            Decimal               @default(0) @map("outside_radius_fee") @db.Decimal(12, 2)
  budgetAmount                Decimal?              @map("budget_amount") @db.Decimal(12, 2)
  subtotal                    Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount              Decimal               @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount                   Decimal               @default(0) @map("tax_amount") @db.Decimal(12, 2)
  serviceFee                  Decimal               @default(0) @map("service_fee") @db.Decimal(12, 2)
  totalAmount                 Decimal               @default(0) @map("total_amount") @db.Decimal(12, 2)
  preferredMenuItemIds        Json?                 @map("preferred_menu_item_ids")
  customMenuItems             Json?                 @map("custom_menu_items")
  referenceImageUrls          Json?                 @map("reference_image_urls")
  paymentPreference           BookingPaymentPreference @default(NO_PREFERENCE) @map("payment_preference")
  specialInstructions         String?               @map("special_instructions")
  isAdultConfirmed            Boolean               @default(false) @map("is_adult_confirmed")
  termsAccepted               Boolean               @default(false) @map("terms_accepted")
  cancellationReason          String?               @map("cancellation_reason")
  acceptedAt                  DateTime?             @map("accepted_at") @db.Timestamptz(6)
  confirmedAt                 DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  completionRequestedAt       DateTime?             @map("completion_requested_at") @db.Timestamptz(6)
  completionRequestedById     String?               @map("completion_requested_by") @db.Uuid
  completionApprovedAt        DateTime?             @map("completion_approved_at") @db.Timestamptz(6)
  completionApprovedById      String?               @map("completion_approved_by") @db.Uuid
  paymentReleasedAt           DateTime?             @map("payment_released_at") @db.Timestamptz(6)
  completedAt                 DateTime?             @map("completed_at") @db.Timestamptz(6)
  cancelledAt                 DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  customer                    User                  @relation("BookingCustomer", fields: [customerId], references: [id])
  completionRequestedBy       User?                 @relation("BookingCompletionRequestedBy", fields: [completionRequestedById], references: [id])
  completionApprovedBy        User?                 @relation("BookingCompletionApprovedBy", fields: [completionApprovedById], references: [id])
  vendor                      Vendor                @relation(fields: [vendorId], references: [id])
  foodTruck                   FoodTruck             @relation(fields: [foodTruckId], references: [id])
  communityRequest            CommunityRequest?     @relation(fields: [communityRequestId], references: [id])
  vendorOffer                 VendorOffer?          @relation(fields: [vendorOfferId], references: [id])
  quotes                      BookingQuote[]
  statusHistory               BookingStatusHistory[]
  payments                    Payment[]
  commissions                 Commission[]
  payouts                     Payout[]
  issues                      BookingIssue[]
  review                      Review?
  promotions                  PromotionRedemption[]
  conversations               Conversation[]
  notifications               Notification[]

  @@map("bookings")
}

model BookingIssue {
  id           String             @id @default(uuid()) @db.Uuid
  bookingId    String             @map("booking_id") @db.Uuid
  reportedById String             @map("reported_by") @db.Uuid
  message      String
  status       BookingIssueStatus @default(OPEN)
  resolvedAt   DateTime?          @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  booking      Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reportedBy   User               @relation("BookingIssueReportedBy", fields: [reportedById], references: [id])
  messages     BookingIssueMessage[]

  @@index([bookingId, status])
  @@index([reportedById])
  @@map("booking_issues")
}

model BookingIssueMessage {
  id         String                        @id @default(uuid()) @db.Uuid
  issueId    String                        @map("issue_id") @db.Uuid
  senderId   String                        @map("sender_id") @db.Uuid
  senderRole BookingIssueMessageSenderRole @map("sender_role")
  message    String
  readAt     DateTime?                     @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  issue      BookingIssue                  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sender     User                          @relation("BookingIssueMessageSender", fields: [senderId], references: [id])

  @@index([issueId, createdAt])
  @@index([senderId])
  @@map("booking_issue_messages")
}

model BookingQuote {
  pricePerPerson     Decimal?         @map("price_per_person") @db.Decimal(12, 2)
  id                  String                    @id @default(uuid()) @db.Uuid
  bookingId           String                    @map("booking_id") @db.Uuid
  vendorId            String                    @map("vendor_id") @db.Uuid
  pricingModel        OfferPricingModel?        @map("pricing_model")
  selectedMenuItems   Json?                     @map("selected_menu_items")
  extraCharges        Json?                     @map("extra_charges")
  baseServiceFee      Decimal                   @default(0) @map("base_service_fee") @db.Decimal(12, 2)
  transportFee        Decimal                   @default(0) @map("transport_fee") @db.Decimal(12, 2)
  subtotal            Decimal                   @db.Decimal(12, 2)
  outsideRadiusFee    Decimal                   @default(0) @map("outside_radius_fee") @db.Decimal(12, 2)
  serviceFee          Decimal                   @default(0) @map("service_fee") @db.Decimal(12, 2)
  taxAmount           Decimal                   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount      Decimal                   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount         Decimal                   @map("total_amount") @db.Decimal(12, 2)
  paymentPreference   BookingPaymentPreference? @map("payment_preference")
  depositAmount       Decimal                   @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  depositPercent      Decimal                   @default(0) @map("deposit_percent") @db.Decimal(5, 2)
  balanceDueAtEvent   Decimal                   @default(0) @map("balance_due_at_event") @db.Decimal(12, 2)
  message             String?
  noteToClient        String?                   @map("note_to_client")
  terms               String?
  status              OfferStatus               @default(PENDING)
  expiresAt           DateTime?                 @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking             Booking                   @relation(fields: [bookingId], references: [id])
  vendor              Vendor                    @relation(fields: [vendorId], references: [id])

  @@map("booking_quotes")
}

model BookingHold {
  id          String    @id @default(uuid()) @db.Uuid
  foodTruckId String    @map("food_truck_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  foodTruck   FoodTruck @relation(fields: [foodTruckId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@map("booking_holds")
}

model BookingStatusHistory {
  id             String         @id @default(uuid()) @db.Uuid
  bookingId      String         @map("booking_id") @db.Uuid
  previousStatus BookingStatus? @map("previous_status")
  newStatus      BookingStatus  @map("new_status")
  changedById    String?        @map("changed_by") @db.Uuid
  reason         String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  booking        Booking        @relation(fields: [bookingId], references: [id])
  changedBy      User?          @relation("BookingStatusChangedBy", fields: [changedById], references: [id])

  @@map("booking_status_history")
}
