enum ReviewStatus {
  PUBLISHED
  UNDER_REVIEW
  HIDDEN
  REMOVED
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Review {
  id                String       @id @default(uuid()) @db.Uuid
  bookingId         String       @unique @map("booking_id") @db.Uuid
  customerId        String       @map("customer_id") @db.Uuid
  vendorId          String       @map("vendor_id") @db.Uuid
  foodTruckId       String       @map("food_truck_id") @db.Uuid
  rating            Int
  title             String?      @db.VarChar(255)
  content           String?
  isVerified        Boolean      @default(true) @map("is_verified")
  status            ReviewStatus @default(PUBLISHED)
  contentHidden     Boolean      @default(false) @map("content_hidden")
  ratingVisible     Boolean      @default(true) @map("rating_visible")
  vendorResponse    String?      @map("vendor_response")
  vendorRespondedAt DateTime?    @map("vendor_responded_at") @db.Timestamptz(6)
  moderatedById     String?      @map("moderated_by") @db.Uuid
  moderatedAt       DateTime?    @map("moderated_at") @db.Timestamptz(6)
  moderationReason  String?      @map("moderation_reason")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  booking           Booking      @relation(fields: [bookingId], references: [id])
  customer          User         @relation("ReviewCustomer", fields: [customerId], references: [id])
  vendor            Vendor       @relation(fields: [vendorId], references: [id])
  foodTruck         FoodTruck    @relation(fields: [foodTruckId], references: [id])
  moderatedBy       User?        @relation("ReviewModeratedBy", fields: [moderatedById], references: [id])
  reports           ReviewReport[]

  @@map("reviews")
}

model ReviewReport {
  id              String       @id @default(uuid()) @db.Uuid
  reviewId        String       @map("review_id") @db.Uuid
  reportedById    String       @map("reported_by") @db.Uuid
  reason          String       @db.VarChar(255)
  description     String?
  status          ReportStatus @default(PENDING)
  reviewedById    String?      @map("reviewed_by") @db.Uuid
  resolutionNotes String?      @map("resolution_notes")
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  review          Review       @relation(fields: [reviewId], references: [id])
  reportedBy      User         @relation("ReviewReportReportedBy", fields: [reportedById], references: [id])
  reviewedBy      User?        @relation("ReviewReportReviewedBy", fields: [reviewedById], references: [id])

  @@map("review_reports")
}
