enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id                      String         @id @default(uuid()) @db.Uuid
  bookingId               String         @map("booking_id") @db.Uuid
  payerUserId             String         @map("payer_user_id") @db.Uuid
  vendorId                String         @map("vendor_id") @db.Uuid
  stripePaymentIntentId   String?        @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeCheckoutSessionId String?        @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  amount                  Decimal        @db.Decimal(12, 2)
  currency                String         @default("USD") @db.VarChar(10)
  status                  PaymentStatus  @default(PENDING)
  idempotencyKey          String?        @unique @map("idempotency_key") @db.VarChar(255)
  paidAt                  DateTime?      @map("paid_at") @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  booking                 Booking        @relation(fields: [bookingId], references: [id])
  payerUser               User           @relation("PaymentPayer", fields: [payerUserId], references: [id])
  vendor                  Vendor         @relation(fields: [vendorId], references: [id])
  commission              Commission?
  refunds                 Refund[]

  @@map("payments")
}

model Commission {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @unique @map("payment_id") @db.Uuid
  bookingId        String   @map("booking_id") @db.Uuid
  vendorId         String   @map("vendor_id") @db.Uuid
  grossAmount      Decimal  @map("gross_amount") @db.Decimal(12, 2)
  commissionRate   Decimal  @map("commission_rate") @db.Decimal(6, 3)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(12, 2)
  vendorNetAmount  Decimal  @map("vendor_net_amount") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payment          Payment  @relation(fields: [paymentId], references: [id])
  booking          Booking  @relation(fields: [bookingId], references: [id])
  vendor           Vendor   @relation(fields: [vendorId], references: [id])

  @@map("commissions")
}

model Refund {
  id             String        @id @default(uuid()) @db.Uuid
  paymentId      String        @map("payment_id") @db.Uuid
  stripeRefundId String?       @unique @map("stripe_refund_id") @db.VarChar(255)
  amount         Decimal       @db.Decimal(12, 2)
  reason         String?
  status         PaymentStatus @default(PENDING)
  processedAt    DateTime?     @map("processed_at") @db.Timestamptz(6)
  payment        Payment       @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  vendorId         String       @map("vendor_id") @db.Uuid
  stripeTransferId String?      @unique @map("stripe_transfer_id") @db.VarChar(255)
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("USD") @db.VarChar(10)
  status           PayoutStatus @default(PENDING)
  failureReason    String?      @map("failure_reason")
  paidAt           DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  vendor           Vendor       @relation(fields: [vendorId], references: [id])

  @@map("payouts")
}
