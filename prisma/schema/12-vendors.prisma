enum VendorStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorPlan {
  FREE
  STARTER
  PRO
  ELITE
}

enum VendorSubscriptionStatus {
  INACTIVE
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PhotoShootRequestStatus {
  PENDING
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

model Vendor {
  id                           String                      @id @default(uuid()) @db.Uuid
  userId                       String                      @unique @map("user_id") @db.Uuid
  marketId                     String?                     @map("market_id") @db.Uuid
  businessName                 String                      @map("business_name") @db.VarChar(255)
  businessEmail                String?                     @map("business_email") @db.VarChar(255)
  businessPhone                String?                     @map("business_phone") @db.VarChar(30)
  description                  String?
  logoUrl                      String?                     @map("logo_url")
  websiteUrl                   String?                     @map("website_url")
  selectedPlan                 VendorPlan                  @default(FREE) @map("selected_plan")
  activeSubscriptionTierId     String?                     @map("active_subscription_tier_id") @db.Uuid
  subscriptionStatus           VendorSubscriptionStatus    @default(INACTIVE) @map("subscription_status")
  stripeCustomerId             String?                     @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId         String?                     @unique @map("stripe_subscription_id") @db.VarChar(255)
  subscriptionCurrentPeriodEnd DateTime?                   @map("subscription_current_period_end") @db.Timestamptz(6)
  isFoundingMember             Boolean                     @default(false) @map("is_founding_member")
  foundingJoinedAt             DateTime?                   @map("founding_joined_at") @db.Timestamptz(6)
  trialStartedAt               DateTime?                   @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt                  DateTime?                   @map("trial_ends_at") @db.Timestamptz(6)
  foundingDiscountEndsAt       DateTime?                   @map("founding_discount_ends_at") @db.Timestamptz(6)
  lockedCommissionRate         Decimal?                    @map("locked_commission_rate") @db.Decimal(6, 3)
  status                       VendorStatus                @default(DRAFT)
  isVerified                   Boolean                     @default(false) @map("is_verified")
  verifiedAt                   DateTime?                   @map("verified_at") @db.Timestamptz(6)
  reliabilityScore             Decimal                     @default(0) @map("reliability_score") @db.Decimal(5, 2)
  creditAcceptanceEnabled      Boolean                     @default(true) @map("credit_acceptance_enabled")
  creditAcceptanceUpdatedAt    DateTime?                   @map("credit_acceptance_updated_at") @db.Timestamptz(6)
  approvedById                 String?                     @map("approved_by") @db.Uuid
  approvedAt                   DateTime?                   @map("approved_at") @db.Timestamptz(6)
  rejectionReason              String?                     @map("rejection_reason")
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                    DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  user                         User                        @relation(fields: [userId], references: [id])
  activeSubscriptionTier       VendorSubscriptionTier?     @relation("VendorActiveSubscriptionTier", fields: [activeSubscriptionTierId], references: [id])
  market                       Market?                     @relation(fields: [marketId], references: [id])
  approvedBy                   User?                       @relation("VendorApprovedBy", fields: [approvedById], references: [id])
  verificationRequests         VendorVerificationRequest[]
  paymentAccount               VendorPaymentAccount?
  foodTrucks                   FoodTruck[]
  posts                        Post[]
  offers                       VendorOffer[]
  bookings                     Booking[]
  bookingQuotes                BookingQuote[]
  payments                     Payment[]
  commissions                  Commission[]
  payouts                      Payout[]
  reviews                      Review[]
  vendorBadges                 VendorBadge[]
  leaderboardEntries           LeaderboardEntry[]
  qrKitShipments               QrKitShipment[]
  photoShootRequests           VendorPhotoShootRequest[]
  staffMembers                 VendorStaff[]
  subscriptions                VendorSubscription[]

  @@map("vendors")
}

model VendorSubscriptionTier {
  id                                  String               @id @default(uuid()) @db.Uuid
  code                                String               @unique @db.VarChar(50)
  legacyPlan                          VendorPlan?          @map("legacy_plan")
  name                                String               @db.VarChar(100)
  subtitle                            String?              @db.VarChar(150)
  description                         String?
  badge                               String?              @db.VarChar(100)
  monthlyPriceCents                   Int                  @map("monthly_price_cents")
  foundingMonthlyPriceCentsAfterTrial Int?                 @map("founding_monthly_price_cents_after_trial")
  normalCommissionRate                Decimal?             @map("normal_commission_rate") @db.Decimal(6, 3)
  foundingCommissionRate              Decimal?             @map("founding_commission_rate") @db.Decimal(6, 3)
  bookingEnabled                      Boolean              @default(false) @map("booking_enabled")
  maxStaffAccounts                    Int                  @default(0) @map("max_staff_accounts")
  maxIncludedTrucks                   Int                  @default(1) @map("max_included_trucks")
  additionalTruckMonthlyPriceCents    Int?                 @map("additional_truck_monthly_price_cents")
  analyticsLevel                      String               @default("NONE") @map("analytics_level") @db.VarChar(30)
  sortOrder                           Int                  @default(0) @map("sort_order")
  trialDays                           Int                  @default(90) @map("trial_days")
  features                            Json?
  included                            Json?
  notIncluded                         Json?                @map("not_included")
  stripeProductId                     String?              @unique @map("stripe_product_id") @db.VarChar(255)
  stripePriceId                       String?              @unique @map("stripe_price_id") @db.VarChar(255)
  active                              Boolean              @default(true)
  createdAt                           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  activeVendors                       Vendor[]             @relation("VendorActiveSubscriptionTier")
  vendorSubscriptions                 VendorSubscription[]

  @@map("vendor_subscription_tiers")
}

model VendorSubscription {
  id                   String                   @id @default(uuid()) @db.Uuid
  vendorId             String                   @map("vendor_id") @db.Uuid
  tierId               String                   @map("tier_id") @db.Uuid
  stripeCustomerId     String?                  @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?                  @unique @map("stripe_subscription_id") @db.VarChar(255)
  status               VendorSubscriptionStatus @default(INCOMPLETE)
  monthlyPriceCents    Int                      @map("monthly_price_cents")
  commissionRate       Decimal?                 @map("commission_rate") @db.Decimal(6, 3)
  isFoundingMember     Boolean                  @default(false) @map("is_founding_member")
  trialStartedAt       DateTime?                @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt          DateTime?                @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart   DateTime?                @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime?                @map("current_period_end") @db.Timestamptz(6)
  canceledAt           DateTime?                @map("canceled_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  vendor               Vendor                   @relation(fields: [vendorId], references: [id])
  tier                 VendorSubscriptionTier   @relation(fields: [tierId], references: [id])

  @@index([vendorId, status])
  @@map("vendor_subscriptions")
}

model VendorStaff {
  id           String      @id @default(uuid()) @db.Uuid
  vendorId     String      @map("vendor_id") @db.Uuid
  userId       String      @unique @map("user_id") @db.Uuid
  email        String      @db.VarChar(255)
  pinHash      String      @map("pin_hash") @db.VarChar(255)
  pinEncrypted String      @map("pin_encrypted")
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)
  vendor       Vendor      @relation(fields: [vendorId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@unique([vendorId, email])
  @@map("vendor_staff")
}

model VendorVerificationRequest {
  id              String             @id @default(uuid()) @db.Uuid
  vendorId        String             @map("vendor_id") @db.Uuid
  status          VerificationStatus @default(PENDING)
  documents       Json?
  notes           String?
  reviewedById    String?            @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  vendor          Vendor             @relation(fields: [vendorId], references: [id])
  reviewedBy      User?              @relation("VendorVerificationReviewedBy", fields: [reviewedById], references: [id])

  @@map("vendor_verification_requests")
}

model VendorPaymentAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  vendorId            String   @unique @map("vendor_id") @db.Uuid
  stripeAccountId     String   @unique @map("stripe_account_id") @db.VarChar(255)
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  chargesEnabled      Boolean  @default(false) @map("charges_enabled")
  payoutsEnabled      Boolean  @default(false) @map("payouts_enabled")
  disabledReason      String?  @map("disabled_reason")
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  vendor              Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_payment_accounts")
}

model VendorPhotoShootRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  vendorId      String                  @map("vendor_id") @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  foodTruckId   String?                 @map("food_truck_id") @db.Uuid
  contactName   String?                 @map("contact_name") @db.VarChar(150)
  contactEmail  String?                 @map("contact_email") @db.VarChar(255)
  contactPhone  String?                 @map("contact_phone") @db.VarChar(30)
  city          String?                 @db.VarChar(150)
  preferredDate DateTime?               @map("preferred_date") @db.Date
  notes         String?
  status        PhotoShootRequestStatus @default(PENDING)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  vendor        Vendor                  @relation(fields: [vendorId], references: [id])
  user          User                    @relation(fields: [userId], references: [id])
  foodTruck     FoodTruck?              @relation(fields: [foodTruckId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@map("vendor_photo_shoot_requests")
}
