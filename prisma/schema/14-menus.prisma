enum MenuItemStatus {
  AVAILABLE
  UNAVAILABLE
  SOLD_OUT
}

model Menu {
  id          String         @id @default(uuid()) @db.Uuid
  foodTruckId String         @map("food_truck_id") @db.Uuid
  name        String         @db.VarChar(150)
  description String?
  isActive    Boolean        @default(true) @map("is_active")
  foodTruck   FoodTruck      @relation(fields: [foodTruckId], references: [id])
  categories  MenuCategory[]

  @@map("menus")
}

model MenuCategory {
  id          String     @id @default(uuid()) @db.Uuid
  menuId      String     @map("menu_id") @db.Uuid
  name        String     @db.VarChar(150)
  description String?
  sortOrder   Int        @default(0) @map("sort_order")
  menu        Menu       @relation(fields: [menuId], references: [id])
  items       MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id           String         @id @default(uuid()) @db.Uuid
  categoryId   String         @map("category_id") @db.Uuid
  name         String         @db.VarChar(255)
  description  String?
  imageUrl     String?        @map("image_url")
  price        Decimal        @db.Decimal(12, 2)
  status       MenuItemStatus @default(AVAILABLE)
  isVegetarian Boolean        @default(false) @map("is_vegetarian")
  isVegan      Boolean        @default(false) @map("is_vegan")
  isGlutenFree Boolean        @default(false) @map("is_gluten_free")
  sortOrder    Int            @default(0) @map("sort_order")
  category     MenuCategory   @relation(fields: [categoryId], references: [id])

  @@map("menu_items")
}
